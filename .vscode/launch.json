{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Angular",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "ng-serve",
      "url": "http://localhost:4200/"
    },
    {
      "name": "Debug Angular Func",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "ng-serve-func",
      "url": "http://localhost:4200/"
    },
    {
      "name": "Debug Functions",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "preLaunchTask": "func-debug"
    }
  ]
}
